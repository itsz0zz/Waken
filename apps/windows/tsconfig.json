{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "react-native": [
        "./node_modules/react-native"
      ],
      "react-native-svg": [
        "./node_modules/react-native-svg"
      ],
      "lucide-react-native": [
        "./node_modules/lucide-react-native"
      ],
      "@tanstack/react-query": [
        "./node_modules/@tanstack/react-query"
      ],
      "zustand": [
        "./node_modules/zustand"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-native/*": [
        "./node_modules/react-native/*"
      ],
      "react-native-svg/*": [
        "./node_modules/react-native-svg/*"
      ],
      "lucide-react-native/*": [
        "./node_modules/lucide-react-native/*"
      ],
      "@tanstack/react-query/*": [
        "./node_modules/@tanstack/react-query/*"
      ],
      "zustand/*": [
        "./node_modules/zustand/*"
      ]
    }
  },
  "include": [
    "src",
    "index.js"
  ]
}
