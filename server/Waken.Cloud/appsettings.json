{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cloud": {
    "DataDir": "/data",
    "JoinKeyMinutes": 10,
    "AuthRequestsPerMinute": 10
  }
}
